apiVersion: v1
kind: Secret
metadata:
  name: pacs-secrets
  namespace: pacs-system
  labels:
    app: pacs-server
type: Opaque
stringData:
  # 데이터베이스 연결 문자열
  # 실제 값으로 변경 필요!
  database-url: "postgresql://username:password@postgres-host:5432/pacs_production"
  
  # S3 자격 증명
  # 실제 값으로 변경 필요!
  s3-access-key: "YOUR_AWS_ACCESS_KEY"
  s3-secret-key: "YOUR_AWS_SECRET_KEY"

---
# 참고: 실제 배포 시에는 다음 방법 중 하나 사용
# 1. kubectl create secret 명령어로 직접 생성
# 2. Sealed Secrets 사용
# 3. External Secrets Operator 사용
# 4. Vault 등 Secret 관리 도구 사용

# 예시 (kubectl 명령어):
# kubectl create secret generic pacs-secrets \
#   --namespace=pacs-system \
#   --from-literal=database-url='postgresql://...' \
#   --from-literal=s3-access-key='...' \
#   --from-literal=s3-secret-key='...'

